# myapi runtime configuration.
# Copy to .env (never commit it) or export these variables before starting.

# Bind address. Keep 127.0.0.1 unless you deliberately expose the panel.
HOST=127.0.0.1
PORT=8787

# State, logs and the encryption key live here. Back this directory up.
MYAPI_DATA_DIR=./data

# Optional: base64-encoded 32-byte key. When absent, data/secret.key is created.
# MYAPI_SECRET_KEY=

# Optional: sets the panel password at startup (authoritative when present).
# MYAPI_ADMIN_PASSWORD=

# Advanced upstream overrides.
# MYAPI_UPSTREAM_BASE=https://maas-api.cn-huabei-1.xf-yun.com/v1
# MYAPI_MODELS_BASE=https://astronstudio-api-volces-prod.xf-yun.com/api/v1/model-manager
# MYAPI_WORKSPACE_BASE=https://agent.xfyun.cn/xingchen-studio
# MYAPI_STUDIO_VERSION=3.4.4
# MYAPI_CLIENT_TYPE=22

MYAPI_LOG_LEVEL=info
MYAPI_MAX_BODY_MB=32
MYAPI_MAX_CONCURRENCY=8
MYAPI_TRUST_PROXY=false
TZ=Asia/Shanghai
